rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /blog-images/{uid}/{file} {
      allow get: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@(yeti-dresden[.]org|yeti-leipzig[.]org)$')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      // Published image URLs remain immutable when an author edits a draft.
      allow delete: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@(yeti-dresden[.]org|yeti-leipzig[.]org)$')
        && firestore.get(/databases/(default)/documents/blogUsers/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
